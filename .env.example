# Copy to .env; set local database passwords before docker compose up --build.
DB_PASSWORD=replace-with-your-local-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
# No API key or account password is placed in this file. Login persists in data/browser.
# Set absolute paths when launching Java outside the project root.
# BROWSER_DIRECTORY=/absolute/project/automation
# BROWSER_PYTHON=/absolute/project/automation/.venv/bin/python
