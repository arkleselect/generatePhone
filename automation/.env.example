# Paths default to the parent Java/Vue project's data and dataset directories.
# BROWSER_STATE_DIR=../data/browser
# BROWSER_PROFILE_DIR=../data/browser/profile
# DATASET_ROOT=../dataset
# INPUT_ROOT=../data
HEADLESS=false
# Empty channel uses Playwright's bundled Chromium; chrome uses installed Google Chrome.
BROWSER_CHANNEL=chrome
# Optional: attach to an already logged-in Chrome (144+). Enable remote debugging
# in chrome://inspect/#remote-debugging and allow Chrome's connection prompt.
# BROWSER_EXISTING_CHROME_DIR="~/Library/Application Support/Google/Chrome"
MAX_RETRY=2
GENERATION_TIMEOUT=900
LOG_LEVEL=INFO
# Only the Java bridge needs this; standalone CLI and HTTP generation do not.
# HAMLAB_API_URL=http://127.0.0.1:8080/api
# Account transport: browser (default) or cliproxy (local OAuth proxy).
# ACCOUNT_ENGINE=cliproxy
# CLIPROXY_IMAGE_MODEL=gpt-image-2.5
